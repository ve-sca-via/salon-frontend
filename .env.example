# =====================================================
# SALON MANAGEMENT APP - FRONTEND CONFIGURATION
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. Never commit .env to git!
# =====================================================

# Backend API URL
VITE_BACKEND_URL=http://localhost:8000

# Canonical site origin, used by the server-rendering functions in api/ for
# <link rel="canonical">, og:url and sitemap.xml. Set this on the Vercel project
# (no VITE_ prefix needed - those functions read process.env, not import.meta).
# Production falls back to https://www.lubist.com when unset.
# SITE_URL=https://www.lubist.com

# Application Environment (optional)
# Set to 'production' to use production mode features
# Leave empty or set to 'development' for development/demo mode
# Note: Vite automatically sets MODE based on build command (dev/build)
# VITE_APP_ENV=production

# Optional: Analytics & Monitoring
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
